{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "leader",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(php -l:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Website:*)",
      "PowerShell(Get-WebAppPoolState:*)",
      "PowerShell(Get-NetTCPConnection:*)",
      "PowerShell(Test-NetConnection:*)",
      "PowerShell(Get-WinEvent:*)",
      "PowerShell(Get-Service:*)",
      "PowerShell(Get-WebBinding:*)",
      "PowerShell(Get-Item:*)",
      "Bash(git show:*)",
      "Bash(ng build:*)",
      "Bash(ng test:*)",
      "Bash(ng lint:*)",
      "Bash(dotnet format:*)",
      "Bash(npx ng:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "PowerShell(Restart-Service:*)",
      "PowerShell(Stop-Service:*)",
      "PowerShell(Restart-WebAppPool:*)",
      "PowerShell(Start-WebAppPool:*)",
      "PowerShell(Restart-Computer:*)",
      "PowerShell(Stop-Computer:*)",
      "Bash(shutdown:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pfx)",
      "Edit(**/*.key)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pfx)",
      "Write(**/*.key)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/*.log)",
      "Read(**/*.etl)",
      "Read(**/*.dmp)",
      "Read(**/IISLogs/**)",
      "Read(**/W3SVC*/**)",
      "Read(**/stdout*)",
      "Read(**/*.bak)",
      "Read(**/*.mdf)",
      "Read(**/*.ldf)",
      "Read(**/.claude/worktrees/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-command-guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.ps1\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
